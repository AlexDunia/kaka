# Leave this as /api when using the Vite or production reverse proxy.
# An absolute URL must include /api and use the same site as the frontend.
VITE_API_URL=/api
# Local proxy target; use the same hostname throughout the browser session.
VITE_DEV_BACKEND_URL=http://localhost:8000
# Demo fixtures are opt-in and are always disabled in production builds.
VITE_DEMO_MODE=false
